# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=visuomotor
POSTGRES_PASSWORD=visuomotor_dev
POSTGRES_DB=visuomotor_db
DATABASE_URL=postgresql://visuomotor:visuomotor_dev@localhost:5432/visuomotor_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=app.py
FLASK_RUN_PORT=5000

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ─── Financial News API (Marketaux: recommended for NSE/BSE intraday context) ──
# Sign up at https://marketaux.com
NEWS_API_KEY=REPLACE_WITH_LIVE_MARKETAUX_API_KEY
NEWS_API_BASE_URL=https://api.marketaux.com/v1

# ─── OpenAI (LLM for AI Catalyst) ────────────────────────────────────────────
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# ─── LangSmith Observability (optional but recommended) ──────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=REPLACE_WITH_LANGSMITH_API_KEY
LANGCHAIN_PROJECT=visuomotor-smart-watchlist

# ─── PagerDuty Alerting (for nightly batch health checks) ────────────────────
PAGERDUTY_ROUTING_KEY=REPLACE_WITH_PAGERDUTY_ROUTING_KEY

# ─── Circuit Breaker Config ───────────────────────────────────────────────────
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=300

# ─── Anomaly Detection Tuning ─────────────────────────────────────────────────
ISOLATION_FOREST_CONTAMINATION=0.05
ISOLATION_FOREST_N_ESTIMATORS=100
ZSCORE_STANDARD_THRESHOLD=3.0
ZSCORE_MARKET_OPEN_THRESHOLD=4.5
